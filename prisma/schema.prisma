generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────

enum UserRole {
  DONOR
  VOLUNTEER
  ADMIN

  @@map("user_roles")
}

enum DonationType {
  ONE_TIME
  MONTHLY

  @@map("donation_types")
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED

  @@map("donation_statuses")
}

enum SponsorshipStatus {
  ACTIVE
  PAUSED
  CANCELLED

  @@map("sponsorship_statuses")
}

// ─── AUTH & USERS ─────────────────────────────────────────────

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  firstName     String        @db.VarChar(100)
  lastName      String        @db.VarChar(100)
  passwordHash  String?
  role          UserRole      @default(DONOR)
  emailVerified DateTime?
  image         String?
  stripeCustId  String?       @unique
  paypalCustId  String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  donations            Donation[]
  sponsorships         Sponsorship[]
  accounts             Account[]
  sessions             Session[]
  passwordResetTokens  PasswordResetToken[]

  @@index([role])
  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String  @db.VarChar(255)
  provider          String  @db.VarChar(255)
  providerAccountId String  @db.VarChar(255)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(255)
  scope             String? @db.VarChar(255)
  id_token          String? @db.Text
  session_state     String? @db.VarChar(255)
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── DONATIONS & PAYMENTS ─────────────────────────────────────

model Donation {
  id                 String         @id @default(uuid())
  amount             Decimal        @db.Decimal(10, 2)
  currency           String         @default("USD") @db.VarChar(3)
  type               DonationType
  status             DonationStatus @default(PENDING)
  provider           String         @default("stripe") @db.VarChar(50)
  providerPaymentId  String?        @unique
  providerSessionId  String?        @unique
  userId             String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sponsorship  Sponsorship?

  @@index([userId])
  @@index([status])
  @@index([provider])
  @@index([createdAt])
  @@map("donations")
}

model WebhookEvent {
  id             String   @id @default(uuid())
  provider       String   @db.VarChar(50)
  providerEventId String  @unique
  type           String   @db.VarChar(255)
  processedAt    DateTime @default(now())

  @@index([providerEventId])
  @@index([provider])
  @@index([processedAt])
  @@map("webhook_events")
}

// ─── SPONSORSHIP ──────────────────────────────────────────────

model Sponsorship {
  id         String              @id @default(uuid())
  userId     String
  childId    String
  donationId String?             @unique
  startDate  DateTime            @default(now())
  status     SponsorshipStatus   @default(ACTIVE)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  child    Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  donation Donation? @relation(fields: [donationId], references: [id], onDelete: SetNull)

  @@unique([userId, childId])
  @@index([userId])
  @@index([childId])
  @@index([status])
  @@map("sponsorships")
}

model Child {
  id          String  @id @default(uuid())
  firstName   String  @db.VarChar(100)
  country     String  @db.VarChar(100)
  birthDate   DateTime?
  photoUrl    String?
  bio         String? @db.Text
  isSponsored Boolean @default(false)
  program     String? @db.VarChar(255)
  createdAt   DateTime @default(now())

  sponsorships Sponsorship[]

  @@index([country])
  @@index([isSponsored])
  @@map("children")
}

// ─── PROGRAMS ─────────────────────────────────────────────────

model Program {
  id               String  @id @default(uuid())
  slug             String  @unique
  title            String  @db.VarChar(255)
  shortDescription String  @db.VarChar(500)
  fullDescription  String  @db.Text
  heroImage        String?
  icon             String? @db.VarChar(50)
  sortOrder        Int     @default(0)
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  projects Project[]

  @@index([slug])
  @@index([isActive])
  @@map("programs")
}

model Project {
  id          String  @id @default(uuid())
  programId   String
  name        String  @db.VarChar(255)
  country     String  @db.VarChar(100)
  description String  @db.Text
  stats       Json?
  createdAt   DateTime @default(now())

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
  @@index([country])
  @@map("projects")
}

// ─── IMPACT STORIES ───────────────────────────────────────────

model ImpactStory {
  id          String  @id @default(uuid())
  title       String  @db.VarChar(255)
  subtitle    String  @db.VarChar(255)
  description String  @db.Text
  ctaText     String? @db.VarChar(100)
  image       String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())

  @@index([isActive])
  @@index([sortOrder])
  @@map("impact_stories")
}

// ─── CONTACT FORM ─────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(100)
  email     String   @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  subject   String?  @db.VarChar(200)
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@map("contact_messages")
}

// ─── SECURITY ─────────────────────────────────────────────────

model SecurityLog {
  id        String   @id @default(uuid())
  type      String   @db.VarChar(100)
  userId    String?
  ip        String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(500)
  details   String?  @db.Text
  timestamp DateTime @default(now())

  @@index([type])
  @@index([timestamp])
  @@index([userId])
  @@map("security_logs")
}

// ─── PASSWORD RESET ───────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expires   DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}
